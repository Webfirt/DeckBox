# ──────────────────────────────────────────────
# Configuration SMTP pour l'envoi d'emails
# Copie ce fichier en .env et remplis les valeurs
# ──────────────────────────────────────────────

# Pour Gmail :
# 1. Active la validation en 2 étapes sur ton compte Google
# 2. Va sur https://myaccount.google.com/apppasswords
# 3. Crée un "Mot de passe d'application" pour "Mail"
# 4. Utilise ce mot de passe généré dans SMTP_PASS (pas ton vrai mot de passe Gmail)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton.email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Pour lancer le backend avec ces variables :
# Windows PowerShell :
#   $env:SMTP_USER="ton.email@gmail.com"; $env:SMTP_PASS="xxxx xxxx xxxx xxxx"; .\gradlew.bat :backend:run
#
# Sans SMTP configuré : le code s'affiche dans les logs du serveur (mode développement)
